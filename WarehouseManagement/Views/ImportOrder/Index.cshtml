@{
    ViewData["Title"] = "Quản lý Phiếu nhập kho";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Phiếu Nhập Kho</h1>
        <p class="page-subtitle">Quy trình nhập kho 2 bước: Lập đơn & Xác nhận kiểm đếm nhập hàng thực tế</p>
    </div>
    <button class="btn btn-primary" onclick="openModal('createImportModal')">
        <i class="fa-solid fa-plus"></i> Tạo phiếu nhập kho
    </button>
</div>

<!-- THANH TÌM KIẾM & BỘ LỌC -->
<div class="card toolbar-card">
    <div class="toolbar">
        <div class="search-box">
            <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="searchImportInput" placeholder="Tìm theo mã phiếu PN, tên nhà cung cấp..." onkeyup="filterImports()" />
        </div>
        <div class="filters">
            <select id="importStatusFilter" onchange="filterImports()" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="pending">Chờ kiểm đếm / Chờ duyệt</option>
                <option value="completed">Đã nhập kho</option>
                <option value="cancelled">Đã hủy</option>
            </select>
        </div>
    </div>
</div>

<!-- BẢNG DỮ LIỆU PHIẾU NHẬP -->
<div class="card table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>MÃ PHIẾU</th>
                    <th>NHÀ CUNG CẤP</th>
                    <th>NGÀY TẠO</th>
                    <th>NGƯỜI LẬP</th>
                    <th>TỔNG SỐ LƯỢNG</th>
                    <th>TỔNG TIỀN</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-right">THAO TÁC</th>
                </tr>
            </thead>
            <tbody id="importTableBody">
                <tr data-status="pending">
                    <td class="font-mono"><strong>PN-2026-005</strong></td>
                    <td class="font-medium">Acecook Việt Nam</td>
                    <td style="color:#64748b;">12/10/2026</td>
                    <td>Nguyễn Văn A</td>
                    <td><strong>500 Thùng</strong></td>
                    <td>56,000,000 ₫</td>
                    <td><span class="status-badge status-pending">Chờ kiểm đếm</span></td>
                    <td class="text-right">
                        <button class="btn-action" title="Duyệt nhập kho" onclick="alert('Đã duyệt xác nhận nhập kho!')"><i class="fa-solid fa-check" style="color:#16a34a;"></i></button>
                        <button class="btn-action" title="Xem chi tiết"><i class="fa-solid fa-eye"></i></button>
                        <button class="btn-action delete" title="Hủy phiếu"><i class="fa-solid fa-trash-can" style="color:#ef4444;"></i></button>
                    </td>
                </tr>
                <tr data-status="completed">
                    <td class="font-mono"><strong>PN-2026-004</strong></td>
                    <td class="font-medium">Coca-Cola VN</td>
                    <td style="color:#64748b;">10/10/2026</td>
                    <td>Lê Hoàng Nam</td>
                    <td><strong>2,000 Lon</strong></td>
                    <td>17,000,000 ₫</td>
                    <td><span class="status-badge status-completed">Đã nhập kho</span></td>
                    <td class="text-right">
                        <button class="btn-action" title="Xem chi tiết"><i class="fa-solid fa-eye"></i></button>
                        <button class="btn-action" title="In phiếu"><i class="fa-solid fa-print"></i></button>
                    </td>
                </tr>
                <tr data-status="completed">
                    <td class="font-mono"><strong>PN-2026-003</strong></td>
                    <td class="font-medium">Orion Vina</td>
                    <td style="color:#64748b;">05/10/2026</td>
                    <td>Trần Thị B</td>
                    <td><strong>300 Hộp</strong></td>
                    <td>14,400,000 ₫</td>
                    <td><span class="status-badge status-completed">Đã nhập kho</span></td>
                    <td class="text-right">
                        <button class="btn-action" title="Xem chi tiết"><i class="fa-solid fa-eye"></i></button>
                        <button class="btn-action" title="In phiếu"><i class="fa-solid fa-print"></i></button>
                    </td>
                </tr>
                <tr data-status="cancelled">
                    <td class="font-mono"><strong>PN-2026-002</strong></td>
                    <td class="font-medium">Coca-Cola VN</td>
                    <td style="color:#64748b;">01/10/2026</td>
                    <td>Nguyễn Văn A</td>
                    <td><strong>100 Lon</strong></td>
                    <td>850,000 ₫</td>
                    <td><span class="status-badge status-cancelled">Đã hủy</span></td>
                    <td class="text-right">
                        <button class="btn-action" title="Xem chi tiết"><i class="fa-solid fa-eye"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG -->
    <div class="table-pagination">
        <span class="pagination-info">Hiển thị 4 trên 4 phiếu nhập</span>
        <div class="pagination-buttons">
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-left"></i></button>
            <button class="btn-page active">1</button>
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>
</div>

<!-- MODAL TẠO PHIẾU NHẬP -->
<div id="createImportModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 700px;">
        <div class="modal-header">
            <h3>Tạo phiếu nhập kho mới</h3>
            <button class="modal-close" onclick="closeModal('createImportModal')">&times;</button>
        </div>
        <form onsubmit="handleSaveImport(event)">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Mã phiếu nhập</label>
                        <input type="text" class="form-input" value="PN-2026-006" readonly style="background:#f1f5f9;" />
                    </div>
                    <div class="form-group flex-2">
                        <label class="form-label">Chọn Nhà cung cấp <span class="required">*</span></label>
                        <select class="form-select" required>
                            <option value="">-- Chọn đối tác cung ứng --</option>
                            <option>Coca-Cola Việt Nam</option>
                            <option>Acecook Việt Nam</option>
                            <option>Orion Vina</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group flex-2">
                        <label class="form-label">Sản phẩm nhập</label>
                        <select class="form-select">
                            <option>Coca Cola Lon 330ml (SKU-COCA-330)</option>
                            <option>Mì Hảo Hảo Chua Cay (SKU-MI-HAOHAO)</option>
                            <option>Bánh Chocopie 12 Cái (SKU-BANH-CHOCO)</option>
                        </select>
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Số lượng nhập</label>
                        <input type="number" class="form-input" placeholder="0" min="1" required />
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Đơn giá nhập</label>
                        <input type="number" class="form-input" placeholder="0" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Hạn sử dụng lô hàng (Nếu có)</label>
                        <input type="date" class="form-input" />
                    </div>
                    <div class="form-group flex-2">
                        <label class="form-label">Ghi chú phiếu nhập</label>
                        <input type="text" class="form-input" placeholder="Lý do nhập, số hóa đơn đỏ..." />
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('createImportModal')">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu phiếu nhập (Chờ duyệt)</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openModal(id) { document.getElementById(id).classList.add('show'); }
    function closeModal(id) { document.getElementById(id).classList.remove('show'); }

    function filterImports() {
        const keyword = document.getElementById('searchImportInput').value.toLowerCase();
        const status = document.getElementById('importStatusFilter').value;
        const rows = document.querySelectorAll('#importTableBody tr');

        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const rowStatus = row.getAttribute('data-status');

            const matchText = text.includes(keyword);
            const matchStatus = !status || rowStatus === status;

            row.style.display = (matchText && matchStatus) ? '' : 'none';
        });
    }

    function handleSaveImport(e) {
        e.preventDefault();
        alert('Tạo phiếu nhập kho thành công! Đang ở trạng thái Chờ kiểm đếm.');
        closeModal('createImportModal');
    }
</script>
}
