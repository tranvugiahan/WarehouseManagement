@{
    ViewData["Title"] = "Quản lý Tài khoản";
}

<style>
    .form-input.is-invalid,
    .form-select.is-invalid {
        border-color: #dc2626 !important;
        background-color: #fef2f2;
    }

    .validation-error {
        display: none;
        color: #dc2626;
        font-size: 0.8rem;
        margin-top: 4px;
        font-weight: 500;
    }

        .validation-error.show {
            display: block;
        }

    .role-option-card {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s ease;
        margin-bottom: 10px;
    }

        .role-option-card:hover {
            border-color: #94a3b8;
            background-color: #f8fafc;
        }

        .role-option-card.selected {
            border-color: #2563eb;
            background-color: #eff6ff;
        }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý Tài khoản</h1>
        <p class="page-subtitle">Phân quyền nhân viên, quản lý tài khoản và trạng thái truy cập hệ thống</p>
    </div>
    <button class="btn btn-primary" onclick="openCreateUserModal()">
        <i class="fa-solid fa-user-plus"></i> Thêm tài khoản
    </button>
</div>

<!-- THANH CÔNG CỤ TÌM KIẾM & BỘ LỌC -->
<div class="card toolbar-card">
    <div class="toolbar">
        <div class="search-box">
            <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="searchUserInput" placeholder="Tìm theo username, họ tên, email..." onkeyup="filterUsers()" />
        </div>
        <div class="filters">
            <select id="userRoleFilter" onchange="filterUsers()" class="form-select">
                <option value="">Tất cả vai trò</option>
                <option value="ADMIN">Admin</option>
                <option value="MANAGER">Quản lý kho</option>
                <option value="EMPLOYEE">Nhân viên kho</option>
            </select>
            <select id="userStatusFilter" onchange="filterUsers()" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="active">Hoạt động</option>
                <option value="inactive">Đã khóa</option>
            </select>
        </div>
    </div>
</div>

<!-- BẢNG DỮ LIỆU TÀI KHOẢN -->
<div class="card table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>TÀI KHOẢN</th>
                    <th>HỌ VÀ TÊN</th>
                    <th>EMAIL</th>
                    <th>VAI TRÒ</th>
                    <th>TRẠNG THÁI</th>
                    <th>NGÀY TẠO</th>
                    <th class="text-right">THAO TÁC</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                <tr data-username="admin" data-fullname="Nguyễn Văn A" data-email="admin@wms.com" data-role="ADMIN" data-status="active">
                    <td class="font-mono"><strong>admin</strong></td>
                    <td class="font-medium col-fullname">Nguyễn Văn A</td>
                    <td class="col-email">admin@wms.com</td>
                    <td class="col-role"><span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:600;">Quản trị viên</span></td>
                    <td class="status-cell"><span class="status-badge status-active">Hoạt động</span></td>
                    <td style="color:#64748b;">10/01/2026</td>
                    <td class="text-right action-cell">
                        <button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                        <button class="btn-action" title="Đổi mật khẩu"><i class="fa-solid fa-key"></i></button>
                    </td>
                </tr>
                <tr data-username="manager_kho" data-fullname="Trần Thị B" data-email="manager@wms.com" data-role="MANAGER" data-status="active">
                    <td class="font-mono"><strong>manager_kho</strong></td>
                    <td class="font-medium col-fullname">Trần Thị B</td>
                    <td class="col-email">manager@wms.com</td>
                    <td class="col-role"><span class="badge" style="background:#fef3c7; color:#b45309; font-weight:600;">Quản lý kho</span></td>
                    <td class="status-cell"><span class="status-badge status-active">Hoạt động</span></td>
                    <td style="color:#64748b;">12/01/2026</td>
                    <td class="text-right action-cell">
                        <button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                        <button class="btn-action" title="Đổi mật khẩu"><i class="fa-solid fa-key"></i></button>
                        <button class="btn-action delete" style="color:#dc2626;" title="Vô hiệu hóa tài khoản" onclick="openDeactivateModal(this)"><i class="fa-solid fa-user-slash"></i></button>
                    </td>
                </tr>
                <tr data-username="staff_nam" data-fullname="Lê Hoàng Nam" data-email="nam.lh@wms.com" data-role="EMPLOYEE" data-status="active">
                    <td class="font-mono"><strong>staff_nam</strong></td>
                    <td class="font-medium col-fullname">Lê Hoàng Nam</td>
                    <td class="col-email">nam.lh@wms.com</td>
                    <td class="col-role"><span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:600;">Nhân viên kho</span></td>
                    <td class="status-cell"><span class="status-badge status-active">Hoạt động</span></td>
                    <td style="color:#64748b;">15/02/2026</td>
                    <td class="text-right action-cell">
                        <button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                        <button class="btn-action" title="Đổi mật khẩu"><i class="fa-solid fa-key"></i></button>
                        <button class="btn-action delete" style="color:#dc2626;" title="Vô hiệu hóa tài khoản" onclick="openDeactivateModal(this)"><i class="fa-solid fa-user-slash"></i></button>
                    </td>
                </tr>
                <tr data-username="staff_tam" data-fullname="Võ Minh Tâm" data-email="tam.vm@wms.com" data-role="EMPLOYEE" data-status="inactive">
                    <td class="font-mono"><strong>staff_tam</strong></td>
                    <td class="font-medium col-fullname">Võ Minh Tâm</td>
                    <td class="col-email">tam.vm@wms.com</td>
                    <td class="col-role"><span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:600;">Nhân viên kho</span></td>
                    <td class="status-cell"><span class="status-badge status-inactive">Đã khóa</span></td>
                    <td style="color:#64748b;">20/02/2026</td>
                    <td class="text-right action-cell">
                        <button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                        <button class="btn-action" title="Mở khóa"><i class="fa-solid fa-lock-open"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG -->
    <div class="table-pagination">
        <span class="pagination-info" id="paginationInfo">Hiển thị 4 trên 4 tài khoản</span>
        <div class="pagination-buttons">
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-left"></i></button>
            <button class="btn-page active">1</button>
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>
</div>

<!-- MODAL THÊM TÀI KHOẢN (FR2.1, UI-03, MỤC 8.1) -->
<div id="createUserModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <h3>Thêm tài khoản mới</h3>
            <button class="modal-close" onclick="closeModal('createUserModal')">&times;</button>
        </div>
        <form id="createUserForm" novalidate onsubmit="handleCreateUser(event)">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Tên đăng nhập <span class="required">*</span></label>
                        <input type="text" id="createUsername" class="form-input" placeholder="VD: staff_kho1" oninput="validateCreateField('createUsername')" />
                        <span class="validation-error" id="err-createUsername"></span>
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Mật khẩu ban đầu <span class="required">*</span></label>
                        <input type="password" id="createPassword" class="form-input" placeholder="Tối thiểu 6 ký tự" oninput="validateCreateField('createPassword')" />
                        <span class="validation-error" id="err-createPassword"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Họ và tên <span class="required">*</span></label>
                        <input type="text" id="createFullName" class="form-input" placeholder="Nguyễn Văn..." oninput="validateCreateField('createFullName')" />
                        <span class="validation-error" id="err-createFullName"></span>
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Email <span class="required">*</span></label>
                        <input type="email" id="createEmail" class="form-input" placeholder="email@wms.com" oninput="validateCreateField('createEmail')" />
                        <span class="validation-error" id="err-createEmail"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Vai trò (Phân quyền) <span class="required">*</span></label>
                        <select id="createRole" class="form-select" onchange="validateCreateField('createRole')">
                            <option value="">-- Chọn vai trò --</option>
                            <option value="EMPLOYEE">Nhân viên kho (EMPLOYEE)</option>
                            <option value="MANAGER">Quản lý kho (MANAGER)</option>
                            <option value="ADMIN">Quản trị viên (ADMIN)</option>
                        </select>
                        <span class="validation-error" id="err-createRole"></span>
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Trạng thái</label>
                        <select id="createStatus" class="form-select">
                            <option value="active">Hoạt động</option>
                            <option value="inactive">Khóa tài khoản</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('createUserModal')">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu tài khoản</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL CẬP NHẬT TÀI KHOẢN (FR2.2, UI-03, MỤC 8.1) -->
<div id="editUserModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <h3>Cập nhật thông tin tài khoản</h3>
            <button class="modal-close" onclick="closeModal('editUserModal')">&times;</button>
        </div>
        <form id="editUserForm" novalidate onsubmit="handleUpdateUser(event)">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Tên đăng nhập</label>
                        <input type="text" id="editUsername" class="form-input" readonly style="background-color: #f1f5f9; color: #64748b; cursor: not-allowed;" />
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Họ và tên <span class="required">*</span></label>
                        <input type="text" id="editFullName" class="form-input" placeholder="Nhập họ và tên" oninput="validateEditField('editFullName')" />
                        <span class="validation-error" id="err-editFullName"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Email <span class="required">*</span></label>
                        <input type="email" id="editEmail" class="form-input" placeholder="email@wms.com" oninput="validateEditField('editEmail')" />
                        <span class="validation-error" id="err-editEmail"></span>
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Vai trò (Phân quyền) <span class="required">*</span></label>
                        <select id="editRole" class="form-select" onchange="validateEditField('editRole')">
                            <option value="EMPLOYEE">Nhân viên kho (EMPLOYEE)</option>
                            <option value="MANAGER">Quản lý kho (MANAGER)</option>
                            <option value="ADMIN">Quản trị viên (ADMIN)</option>
                        </select>
                        <span class="validation-error" id="err-editRole"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('editUserModal')">Hủy</button>
                <button type="submit" class="btn btn-primary">Cập nhật thay đổi</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL GÁN VAI TRÒ CHO TÀI KHOẢN (FR2.4, MỤC 3) -->
<div id="assignRoleModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 500px;">
        <div class="modal-header">
            <h3 style="display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-user-shield" style="color: #2563eb;"></i> Gán vai trò tài khoản
            </h3>
            <button class="modal-close" onclick="closeModal('assignRoleModal')">&times;</button>
        </div>
        <form onsubmit="handleAssignRole(event)">
            <div class="modal-body">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label">Tài khoản được phân quyền</label>
                    <select id="assignAccountSelect" class="form-select" onchange="onAssignAccountChange()">
                    </select>
                </div>

                <label class="form-label" style="margin-bottom: 8px; display: block;">Chọn vai trò áp dụng <span class="required">*</span></label>

                <label class="role-option-card" id="roleCard-ADMIN" onclick="selectRoleOption('ADMIN')">
                    <input type="radio" name="assignRoleRadio" value="ADMIN" style="margin-top: 4px;" />
                    <div>
                        <div style="font-weight: 600; color: #b91c1c;">Admin (Quản trị viên hệ thống)</div>
                        <div style="font-size: 0.85rem; color: #475569; margin-top: 2px;">Toàn quyền quản lý tài khoản, cấu hình danh mục, duyệt phiếu và xem Audit Log.</div>
                    </div>
                </label>

                <label class="role-option-card" id="roleCard-MANAGER" onclick="selectRoleOption('MANAGER')">
                    <input type="radio" name="assignRoleRadio" value="MANAGER" style="margin-top: 4px;" />
                    <div>
                        <div style="font-weight: 600; color: #b45309;">Manager (Quản lý kho)</div>
                        <div style="font-size: 0.85rem; color: #475569; margin-top: 2px;">Quản lý sản phẩm, nhà cung cấp, duyệt phiếu nhập/xuất/hủy, kiểm kê và xem báo cáo.</div>
                    </div>
                </label>

                <label class="role-option-card" id="roleCard-EMPLOYEE" onclick="selectRoleOption('EMPLOYEE')">
                    <input type="radio" name="assignRoleRadio" value="EMPLOYEE" style="margin-top: 4px;" />
                    <div>
                        <div style="font-weight: 600; color: #0369a1;">Employee (Nhân viên kho)</div>
                        <div style="font-size: 0.85rem; color: #475569; margin-top: 2px;">Lập phiếu nhập/xuất kho, tra cứu tồn kho và thực hiện kiểm kê hàng hóa.</div>
                    </div>
                </label>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('assignRoleModal')">Hủy</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Lưu phân quyền
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL XÁC NHẬN VÔ HIỆU HÓA TÀI KHOẢN (FR2.3, UI-03, MỤC 8.1) -->
<div id="deactivateUserModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 460px;">
        <div class="modal-header">
            <h3 style="color: #dc2626; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-triangle-exclamation"></i> Xác nhận vô hiệu hóa tài khoản
            </h3>
            <button class="modal-close" onclick="closeModal('deactivateUserModal')">&times;</button>
        </div>
        <div class="modal-body">
            <p style="margin-bottom: 12px; color: #1e293b; line-height: 1.5;">
                Bạn có chắc chắn muốn vô hiệu hóa tài khoản <strong id="deactivateFullName"></strong>
                (<span class="font-mono" id="deactivateUsername" style="font-weight: 600;"></span>)?
            </p>
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px; color: #991b1b; font-size: 0.9rem; line-height: 1.45;">
                <i class="fa-solid fa-circle-info"></i> <strong>Lưu ý:</strong> Tài khoản bị vô hiệu hóa sẽ lập tức bị thu hồi phiên truy cập và <strong>không thể đăng nhập</strong> vào hệ thống cho đến khi được quản trị viên mở khóa lại.
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="closeModal('deactivateUserModal')">Hủy bỏ</button>
            <button type="button" class="btn" style="background: #dc2626; color: #ffffff; border: none;" onclick="confirmDeactivateUser()">
                <i class="fa-solid fa-user-slash"></i> Xác nhận vô hiệu hóa
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let targetUserRow = null;
        let editingUserRow = null;

        function openModal(id) { document.getElementById(id).classList.add('show'); }
        function closeModal(id) { document.getElementById(id).classList.remove('show'); }

        function setFieldError(inputId, message) {
            const input = document.getElementById(inputId);
            const errEl = document.getElementById('err-' + inputId);
            if (!input || !errEl) return;

            if (message) {
                input.classList.add('is-invalid');
                errEl.textContent = message;
                errEl.classList.add('show');
            } else {
                input.classList.remove('is-invalid');
                errEl.textContent = '';
                errEl.classList.remove('show');
            }
        }

        function clearFormValidation(fieldIds) {
            fieldIds.forEach(id => setFieldError(id, ''));
        }

        function getRoleBadgeHtml(role) {
            if (role === 'ADMIN') return '<span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:600;">Quản trị viên</span>';
            if (role === 'MANAGER') return '<span class="badge" style="background:#fef3c7; color:#b45309; font-weight:600;">Quản lý kho</span>';
            return '<span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:600;">Nhân viên kho</span>';
        }

        // --- TẠO TÀI KHOẢN MỚI (FR2.1) ---
        function openCreateUserModal() {
            document.getElementById('createUserForm').reset();
            clearFormValidation(['createUsername', 'createPassword', 'createFullName', 'createEmail', 'createRole']);
            openModal('createUserModal');
        }

        function validateCreateField(fieldId) {
            const val = document.getElementById(fieldId).value.trim();
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            const usernameRegex = /^[a-zA-Z0-9_.-]{3,30}$/;

            if (fieldId === 'createUsername') {
                if (!val) { setFieldError(fieldId, 'Vui lòng nhập tên đăng nhập.'); return false; }
                if (!usernameRegex.test(val)) { setFieldError(fieldId, 'Tên đăng nhập từ 3-30 ký tự, không chứa khoảng trắng hoặc ký tự đặc biệt.'); return false; }
                const exists = Array.from(document.querySelectorAll('#userTableBody tr')).some(r => r.getAttribute('data-username').toLowerCase() === val.toLowerCase());
                if (exists) { setFieldError(fieldId, 'Tên đăng nhập này đã tồn tại trong hệ thống.'); return false; }
            }
            if (fieldId === 'createPassword') {
                if (!val) { setFieldError(fieldId, 'Vui lòng nhập mật khẩu ban đầu.'); return false; }
                if (val.length < 6) { setFieldError(fieldId, 'Mật khẩu phải có ít nhất 6 ký tự.'); return false; }
            }
            if (fieldId === 'createFullName') {
                if (!val) { setFieldError(fieldId, 'Vui lòng nhập họ và tên.'); return false; }
            }
            if (fieldId === 'createEmail') {
                if (!val) { setFieldError(fieldId, 'Vui lòng nhập địa chỉ email.'); return false; }
                if (!emailRegex.test(val)) { setFieldError(fieldId, 'Định dạng email không hợp lệ (VD: ten@wms.com).'); return false; }
            }
            if (fieldId === 'createRole') {
                if (!val) { setFieldError(fieldId, 'Vui lòng chọn vai trò phân quyền.'); return false; }
            }

            setFieldError(fieldId, '');
            return true;
        }

        function handleCreateUser(e) {
            e.preventDefault();
            const fields = ['createUsername', 'createPassword', 'createFullName', 'createEmail', 'createRole'];
            let isValid = true;
            fields.forEach(f => {
                if (!validateCreateField(f)) isValid = false;
            });
            if (!isValid) return;

            const username = document.getElementById('createUsername').value.trim();
            const fullName = document.getElementById('createFullName').value.trim();
            const email = document.getElementById('createEmail').value.trim();
            const role = document.getElementById('createRole').value;
            const status = document.getElementById('createStatus').value;

            const today = new Date();
            const dateStr = String(today.getDate()).padStart(2, '0') + '/' + String(today.getMonth() + 1).padStart(2, '0') + '/' + today.getFullYear();

            const statusBadge = status === 'active'
                ? '<span class="status-badge status-active">Hoạt động</span>'
                : '<span class="status-badge status-inactive">Đã khóa</span>';

            const actionButtons = status === 'active'
                ? `<button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                   <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                   <button class="btn-action" title="Đổi mật khẩu"><i class="fa-solid fa-key"></i></button>
                   <button class="btn-action delete" style="color:#dc2626;" title="Vô hiệu hóa tài khoản" onclick="openDeactivateModal(this)"><i class="fa-solid fa-user-slash"></i></button>`
                : `<button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                   <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                   <button class="btn-action" title="Mở khóa"><i class="fa-solid fa-lock-open"></i></button>`;

            const tr = document.createElement('tr');
            tr.setAttribute('data-username', username);
            tr.setAttribute('data-fullname', fullName);
            tr.setAttribute('data-email', email);
            tr.setAttribute('data-role', role);
            tr.setAttribute('data-status', status);
            tr.innerHTML = `
                <td class="font-mono"><strong>${username}</strong></td>
                <td class="font-medium col-fullname">${fullName}</td>
                <td class="col-email">${email}</td>
                <td class="col-role">${getRoleBadgeHtml(role)}</td>
                <td class="status-cell">${statusBadge}</td>
                <td style="color:#64748b;">${dateStr}</td>
                <td class="text-right action-cell">${actionButtons}</td>
            `;

            document.getElementById('userTableBody').appendChild(tr);
            closeModal('createUserModal');
            filterUsers();
            alert(`Tạo tài khoản "${username}" thành công!`);
        }

        // --- CẬP NHẬT TÀI KHOẢN (FR2.2) ---
        function openEditUserModal(button) {
            editingUserRow = button.closest('tr');
            clearFormValidation(['editFullName', 'editEmail', 'editRole']);

            document.getElementById('editUsername').value = editingUserRow.getAttribute('data-username');
            document.getElementById('editFullName').value = editingUserRow.getAttribute('data-fullname');
            document.getElementById('editEmail').value = editingUserRow.getAttribute('data-email');
            document.getElementById('editRole').value = editingUserRow.getAttribute('data-role');

            openModal('editUserModal');
        }

        function validateEditField(fieldId) {
            const val = document.getElementById(fieldId).value.trim();
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            if (fieldId === 'editFullName') {
                if (!val) { setFieldError(fieldId, 'Họ và tên không được để trống.'); return false; }
            }
            if (fieldId === 'editEmail') {
                if (!val) { setFieldError(fieldId, 'Email không được để trống.'); return false; }
                if (!emailRegex.test(val)) { setFieldError(fieldId, 'Định dạng email không hợp lệ (VD: ten@wms.com).'); return false; }
            }
            if (fieldId === 'editRole') {
                if (!val) { setFieldError(fieldId, 'Vui lòng chọn vai trò.'); return false; }
            }

            setFieldError(fieldId, '');
            return true;
        }

        function handleUpdateUser(e) {
            e.preventDefault();
            if (!editingUserRow) return;

            const fields = ['editFullName', 'editEmail', 'editRole'];
            let isValid = true;
            fields.forEach(f => {
                if (!validateEditField(f)) isValid = false;
            });
            if (!isValid) return;

            const fullName = document.getElementById('editFullName').value.trim();
            const email = document.getElementById('editEmail').value.trim();
            const role = document.getElementById('editRole').value;

            editingUserRow.setAttribute('data-fullname', fullName);
            editingUserRow.setAttribute('data-email', email);
            editingUserRow.setAttribute('data-role', role);

            editingUserRow.querySelector('.col-fullname').textContent = fullName;
            editingUserRow.querySelector('.col-email').textContent = email;
            editingUserRow.querySelector('.col-role').innerHTML = getRoleBadgeHtml(role);

            const username = editingUserRow.getAttribute('data-username');
            closeModal('editUserModal');
            editingUserRow = null;
            filterUsers();
            alert(`Cập nhật thông tin tài khoản "${username}" thành công!`);
        }

        // --- GÁN VAI TRÒ CHO TÀI KHOẢN (FR2.4) ---
        function openAssignRoleModal(button) {
            const row = button.closest('tr');
            const selectedUsername = row.getAttribute('data-username');
            const selectEl = document.getElementById('assignAccountSelect');

            selectEl.innerHTML = '';
            document.querySelectorAll('#userTableBody tr').forEach(r => {
                const u = r.getAttribute('data-username');
                const fn = r.getAttribute('data-fullname');
                const opt = document.createElement('option');
                opt.value = u;
                opt.textContent = `${fn} (${u})`;
                if (u === selectedUsername) opt.selected = true;
                selectEl.appendChild(opt);
            });

            selectRoleOption(row.getAttribute('data-role'));
            openModal('assignRoleModal');
        }

        function onAssignAccountChange() {
            const selectedUsername = document.getElementById('assignAccountSelect').value;
            const row = Array.from(document.querySelectorAll('#userTableBody tr')).find(r => r.getAttribute('data-username') === selectedUsername);
            if (row) {
                selectRoleOption(row.getAttribute('data-role'));
            }
        }

        function selectRoleOption(role) {
            ['ADMIN', 'MANAGER', 'EMPLOYEE'].forEach(r => {
                const card = document.getElementById('roleCard-' + r);
                const radio = card ? card.querySelector('input[type="radio"]') : null;
                if (r === role) {
                    card.classList.add('selected');
                    if (radio) radio.checked = true;
                } else {
                    card.classList.remove('selected');
                    if (radio) radio.checked = false;
                }
            });
        }

        function handleAssignRole(e) {
            e.preventDefault();
            const username = document.getElementById('assignAccountSelect').value;
            const checkedRadio = document.querySelector('input[name="assignRoleRadio"]:checked');
            if (!username || !checkedRadio) return;

            const newRole = checkedRadio.value;
            const row = Array.from(document.querySelectorAll('#userTableBody tr')).find(r => r.getAttribute('data-username') === username);
            if (row) {
                row.setAttribute('data-role', newRole);
                row.querySelector('.col-role').innerHTML = getRoleBadgeHtml(newRole);
            }

            closeModal('assignRoleModal');
            filterUsers();
            alert(`Đã gán vai trò "${newRole}" cho tài khoản "${username}" thành công!`);
        }

        // --- VÔ HIỆU HÓA TÀI KHOẢN (FR2.3) ---
        function openDeactivateModal(button) {
            targetUserRow = button.closest('tr');
            const username = targetUserRow.getAttribute('data-username');
            const fullName = targetUserRow.getAttribute('data-fullname');

            document.getElementById('deactivateUsername').textContent = username;
            document.getElementById('deactivateFullName').textContent = fullName;
            openModal('deactivateUserModal');
        }

        function confirmDeactivateUser() {
            if (!targetUserRow) return;

            targetUserRow.setAttribute('data-status', 'inactive');

            const statusCell = targetUserRow.querySelector('.status-cell');
            if (statusCell) {
                statusCell.innerHTML = '<span class="status-badge status-inactive">Đã khóa</span>';
            }

            const actionCell = targetUserRow.querySelector('.action-cell');
            if (actionCell) {
                actionCell.innerHTML = `
                    <button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                    <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                    <button class="btn-action" title="Mở khóa"><i class="fa-solid fa-lock-open"></i></button>
                `;
            }

            const username = targetUserRow.getAttribute('data-username');
            closeModal('deactivateUserModal');
            targetUserRow = null;
            filterUsers();
            alert(`Đã vô hiệu hóa tài khoản "${username}" thành công.`);
        }

        // --- TÌM KIẾM & LỌC ---
        function filterUsers() {
            const keyword = document.getElementById('searchUserInput').value.toLowerCase();
            const role = document.getElementById('userRoleFilter').value;
            const status = document.getElementById('userStatusFilter').value;
            const rows = document.querySelectorAll('#userTableBody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                const rowRole = row.getAttribute('data-role');
                const rowStatus = row.getAttribute('data-status');

                const matchText = text.includes(keyword);
                const matchRole = !role || rowRole === role;
                const matchStatus = !status || rowStatus === status;

                const show = (matchText && matchRole && matchStatus);
                row.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });

            const info = document.getElementById('paginationInfo');
            if (info) {
                info.textContent = `Hiển thị ${visibleCount} trên ${rows.length} tài khoản`;
            }
        }
    </script>
}