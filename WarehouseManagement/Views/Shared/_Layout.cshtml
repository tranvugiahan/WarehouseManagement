<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WMS Core</title>
    
   
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- File CSS khung sườn hệ thống -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- 1. SIDEBAR CỐ ĐỊNH BÊN TRÁI -->
    <aside class="app-sidebar">
        <div>
            <div class="sidebar-brand">
                <i class="fa-solid fa-boxes-stacked" style="color: #0f172a;"></i>
                <span>WMS CORE</span>
            </div>
            
            <ul class="sidebar-menu">
                <li>
                    <a href="/Home/Index">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li><a href="/User/Index">
                    <i class="fa-solid fa-users-gear"></i> 
                    <span>Quản lý tài khoản</span>
                </a></li>
                <li><a href="/Product/Index">
                    <i class="fa-solid fa-box"></i> 
                    <span>Sản phẩm</span>
                </a></li>
                <li><a href="/Category/Index">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>Nhóm hàng / Đơn vị</span>
                </a></li>
                <li><a href="/Supplier/Index">
                    <i class="fa-solid fa-truck-field"></i>
                    <span>Nhà cung cấp</span>
                </a></li>
                <li><a href="/ImportOrder/Index">
                    <i class="fa-solid fa-arrow-down-to-bracket"></i>
                    <span>Phiếu nhập</span>
                </a></li>
                <li><a href="/ExportOrder/Index">
                    <i class="fa-solid fa-arrow-up-from-bracket"></i> 
                    <span>Xuất kho</span>
                </a></li>
                <li><a href="/ExportOrder/Damaged">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>Hủy / Hỏng</span>
                </a></li>
                <li><a href="/Inventory/Index">
                    <i class="fa-solid fa-warehouse"></i> <span>Tồn kho</span>
                </a></li>
                <li><a href="/StockTake/Index"><i class="fa-solid fa-clipboard-check"></i> 
                    <span>Kiểm kê</span></a></li>
                <li><a href="/Report/Index">
                    <i class="fa-solid fa-chart-line"></i> 
                    <span>Báo cáo</span>
                </a></li>
            </ul>
        </div>

        <div class="sidebar-footer">
            <ul class="sidebar-menu" style="padding: 0;">
                <li><a href="/Account/Profile"><i class="fa-solid fa-user-circle"></i> <span>Trang cá nhân</span></a></li>
                <li><a href="/AuditLog/Index"><i class="fa-solid fa-clock-rotate-left"></i> <span>Audit Log</span></a></li>
                <li><form action="@Url.Content("~/Auth/Logout")" method="post"><button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i> <span>Đăng xuất</span></button></form></li>
            </ul>
        </div>
    </aside>

    <!-- 2. VÙNG BÊN PHẢI -->
    <div class="app-main">
        <!-- HEADER CỐ ĐỊNH TRÊN CÙNG -->
        <header class="app-header">
            <div class="header-breadcrumb">
                <i class="fa-solid fa-house" style="font-size: 12px; margin-right: 6px;"></i> Quản lý Kho / <span>@ViewData["Title"]</span>
            </div>
            <div class="header-user">
                <span>@User.Identity?.Name <b>(@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</b></span>
                <div class="user-avatar">@User.Identity?.Name?.FirstOrDefault()</div>
            </div>
        </header>

        <!-- NỘI DUNG THAY ĐỔI CỦA TỪNG TRANG -->
        <main class="app-content">
            @RenderBody()
        </main>
    </div>

    <!-- Nhúng Script hỗ trợ -->
    @await RenderSectionAsync("Scripts", required: false)
    <script>
    // Tự động tìm xem đang ở link nào để gắn màu active
    const currentPath = window.location.pathname;
    document.querySelectorAll('.sidebar-menu a').forEach(link => {
        link.classList.remove('active');
        const href = link.getAttribute('href');
        if (href === currentPath || (currentPath === '/' && href === '/Home/Index')) {
            link.classList.add('active');
        }
    });
    </script>

</body>
</html>
