@{
    ViewData["Title"] = "Báo cáo Thống kê Kho";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Báo cáo & Thống kê Kho</h1>
        <p class="page-subtitle">Báo cáo Nhập - Xuất - Tồn (NXT), giá trị hàng hóa và dự báo luân chuyển hàng</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <button class="btn btn-secondary" onclick="alert('Đang xuất báo cáo định dạng Excel...')"><i class="fa-solid fa-file-excel"></i> Xuất Excel</button>
        <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print"></i> In báo cáo</button>
    </div>
</div>

<!-- BỘ LỌC KỲ BÁO CÁO -->
<div class="card toolbar-card">
    <div class="toolbar">
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <label style="font-size: 13px; font-weight: 600; color: #475569;">Kỳ báo cáo:</label>
            <input type="date" class="form-input" value="2026-10-01" />
            <span style="color: #94a3b8;">đến</span>
            <input type="date" class="form-input" value="2026-10-13" />
            
            <select class="form-select">
                <option>Báo cáo Nhập - Xuất - Tồn (NXT)</option>
                <option>Báo cáo Hàng cận Hạn sử dụng</option>
                <option>Báo cáo Giá trị vốn tồn kho</option>
                <option>Báo cáo Xuất hủy / Hỏng hóc</option>
            </select>
        </div>
        <button class="btn btn-primary" onclick="alert('Đã cập nhật dữ liệu báo cáo theo kỳ!')">Lọc số liệu</button>
    </div>
</div>

<!-- 4 THẺ TỔNG HỢP TRONG KỲ -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon blue"><i class="fa-solid fa-boxes-stacked"></i></div>
        <div class="kpi-info">
            <span class="kpi-value">11,280</span>
            <span class="kpi-label">Tồn đầu kỳ</span>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon green"><i class="fa-solid fa-arrow-down"></i></div>
        <div class="kpi-info">
            <span class="kpi-value">+2,800</span>
            <span class="kpi-label">Tổng lượng nhập</span>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon amber"><i class="fa-solid fa-arrow-up"></i></div>
        <div class="kpi-info">
            <span class="kpi-value">-1,630</span>
            <span class="kpi-label">Tổng lượng xuất</span>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon purple"><i class="fa-solid fa-flag-checkered"></i></div>
        <div class="kpi-info">
            <span class="kpi-value">12,450</span>
            <span class="kpi-label">Tồn cuối kỳ</span>
        </div>
    </div>
</div>

<!-- BẢNG BÁO CÁO NXT CHI TIẾT -->
