@using System.Security.Claims
@model IReadOnlyList<WarehouseManagement.Services.UserSummary>
@{
    ViewData["Title"] = "Quản lý Tài khoản";
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId);
}

@section Styles {
    <link rel="stylesheet" href="~/css/user-management.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý Tài khoản</h1>
        <p class="page-subtitle">Phân quyền nhân viên, quản lý tài khoản và trạng thái truy cập hệ thống</p>
    </div>
    <button class="btn btn-primary" onclick="openCreateUserModal()">
        <i class="fa-solid fa-user-plus"></i> Thêm tài khoản
    </button>
</div>

@Html.AntiForgeryToken()

<!-- THANH CÔNG CỤ TÌM KIẾM & BỘ LỌC -->
<div class="card toolbar-card">
    <div class="toolbar">
        <div class="search-box">
            <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="searchUserInput" placeholder="Tìm theo username, họ tên, email..." onkeyup="filterUsers()" />
        </div>
        <div class="filters">
            <select id="userRoleFilter" onchange="filterUsers()" class="form-select">
                <option value="">Tất cả vai trò</option>
                <option value="ADMIN">Admin</option>
                <option value="MANAGER">Quản lý kho</option>
                <option value="EMPLOYEE">Nhân viên kho</option>
            </select>
            <select id="userStatusFilter" onchange="filterUsers()" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="active">Hoạt động</option>
                <option value="inactive">Đã khóa</option>
            </select>
        </div>
    </div>
</div>

<!-- BẢNG DỮ LIỆU TÀI KHOẢN -->
<div class="card table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>TÀI KHOẢN</th>
                    <th>HỌ VÀ TÊN</th>
                    <th>EMAIL</th>
                    <th>VAI TRÒ</th>
                    <th>TRẠNG THÁI</th>
                    <th>NGÀY TẠO</th>
                    <th class="text-right">THAO TÁC</th>
                </tr>
            </thead>
            <tbody id="userTableBody" data-create-url="@Url.Action("Create", "User")"
                   data-update-url="@Url.Action("Update", "User")" data-deactivate-url="@Url.Action("Deactivate", "User")"
                   data-activate-url="@Url.Action("Activate", "User")" data-current-user-id="@currentUserId">
                @foreach (var account in Model)
                {
                    var isActive = account.Status == "ACTIVE";
                    <tr data-id="@account.Id" data-username="@account.Username" data-fullname="@account.FullName"
                        data-email="@account.Email" data-role="@account.Role" data-status="@(isActive ? "active" : "inactive")">
                        <td class="font-mono"><strong>@account.Username</strong></td>
                        <td class="font-medium col-fullname">@account.FullName</td>
                        <td class="col-email">@account.Email</td>
                        <td class="col-role">
                            <span class="badge role-@account.Role.ToLowerInvariant()">@((account.Role == "ADMIN") ? "Quản trị viên" : account.Role == "MANAGER" ? "Quản lý kho" : "Nhân viên kho")</span>
                        </td>
                        <td class="status-cell">
                            <span class="status-badge @(isActive ? "status-active" : "status-inactive")">@(isActive ? "Hoạt động" : "Đã khóa")</span>
                        </td>
                        <td>@account.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-right action-cell">
                            <button type="button" class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button type="button" class="btn-action" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                            @if (isActive)
                            {
                                <button type="button" class="btn-action delete" title="Vô hiệu hóa tài khoản" onclick="openDeactivateModal(this)"><i class="fa-solid fa-user-slash"></i></button>
                            }
                            else
                            {
                                <button type="button" class="btn-action" title="Kích hoạt lại tài khoản" aria-label="Kích hoạt lại @account.Username" onclick="activateUser(this)"><i class="fa-solid fa-lock-open"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-pagination">
        <span class="pagination-info" id="paginationInfo">Hiển thị @Model.Count trên @Model.Count tài khoản</span>
    </div>
</div>

<!-- CÁC COMPONENT MODAL ĐÃ TÁCH RIÊNG -->
<partial name="Partials/_CreateUserModal" />
<partial name="Partials/_EditUserModal" />
<partial name="Partials/_AssignRoleModal" />
<partial name="Partials/_DeactivateUserModal" />

@section Scripts {
    <script src="~/js/user-management.js" asp-append-version="true"></script>
}
