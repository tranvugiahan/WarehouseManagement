@{
    Layout = null; // Trang đăng nhập UI-01 không dùng Layout có Sidebar
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - WMS Core</title>
    <link rel="stylesheet" href="~/css/stylelogin.css" asp-append-version="true" />
</head>
<body>

    <div class="login-card">
        <div class="brand">
            <span>WMS CORE</span>
        </div>
        <h2 class="title">Đăng nhập</h2>
        <p class="subtitle">Nhập tài khoản để truy cập kho hàng</p>

        <form action="/" method="post">
            <div class="form-group">
                <label class="form-label">Tên đăng nhập / Email</label>
                <input type="text" class="form-input" placeholder="Tài khoản or email..." required />
            </div>

            <div class="form-group">
                <label class="form-label">Mật khẩu</label>
                <input type="password" class="form-input" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn-login">Đăng nhập</button>
        </form>
    </div>

</body>
</html>
