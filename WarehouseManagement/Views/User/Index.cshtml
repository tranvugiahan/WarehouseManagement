@{
    ViewData["Title"] = "Quản lý Tài khoản";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user-management.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý Tài khoản</h1>
        <p class="page-subtitle">Phân quyền nhân viên, quản lý tài khoản và trạng thái truy cập hệ thống</p>
    </div>
    <button class="btn btn-primary" onclick="openCreateUserModal()">
        <i class="fa-solid fa-user-plus"></i> Thêm tài khoản
    </button>
</div>

<!-- THANH CÔNG CỤ TÌM KIẾM & BỘ LỌC -->
<div class="card toolbar-card">
    <div class="toolbar">
        <div class="search-box">
            <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="searchUserInput" placeholder="Tìm theo username, họ tên, email..." onkeyup="filterUsers()" />
        </div>
        <div class="filters">
            <select id="userRoleFilter" onchange="filterUsers()" class="form-select">
                <option value="">Tất cả vai trò</option>
                <option value="ADMIN">Admin</option>
                <option value="MANAGER">Quản lý kho</option>
                <option value="EMPLOYEE">Nhân viên kho</option>
            </select>
            <select id="userStatusFilter" onchange="filterUsers()" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="active">Hoạt động</option>
                <option value="inactive">Đã khóa</option>
            </select>
        </div>
    </div>
</div>

<!-- BẢNG DỮ LIỆU TÀI KHOẢN -->
<div class="card table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>TÀI KHOẢN</th>
                    <th>HỌ VÀ TÊN</th>
                    <th>EMAIL</th>
                    <th>VAI TRÒ</th>
                    <th>TRẠNG THÁI</th>
                    <th>NGÀY TẠO</th>
                    <th class="text-right">THAO TÁC</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                <tr data-username="admin" data-fullname="Nguyễn Văn A" data-email="admin@wms.com" data-role="ADMIN" data-status="active">
                    <td class="font-mono"><strong>admin</strong></td>
                    <td class="font-medium col-fullname">Nguyễn Văn A</td>
                    <td class="col-email">admin@wms.com</td>
                    <td class="col-role"><span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:600;">Quản trị viên</span></td>
                    <td class="status-cell"><span class="status-badge status-active">Hoạt động</span></td>
                    <td style="color:#64748b;">10/01/2026</td>
                    <td class="text-right action-cell">
                        <button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                        <button class="btn-action" title="Đổi mật khẩu"><i class="fa-solid fa-key"></i></button>
                    </td>
                </tr>
                <tr data-username="manager_kho" data-fullname="Trần Thị B" data-email="manager@wms.com" data-role="MANAGER" data-status="active">
                    <td class="font-mono"><strong>manager_kho</strong></td>
                    <td class="font-medium col-fullname">Trần Thị B</td>
                    <td class="col-email">manager@wms.com</td>
                    <td class="col-role"><span class="badge" style="background:#fef3c7; color:#b45309; font-weight:600;">Quản lý kho</span></td>
                    <td class="status-cell"><span class="status-badge status-active">Hoạt động</span></td>
                    <td style="color:#64748b;">12/01/2026</td>
                    <td class="text-right action-cell">
                        <button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                        <button class="btn-action" title="Đổi mật khẩu"><i class="fa-solid fa-key"></i></button>
                        <button class="btn-action delete" style="color:#dc2626;" title="Vô hiệu hóa tài khoản" onclick="openDeactivateModal(this)"><i class="fa-solid fa-user-slash"></i></button>
                    </td>
                </tr>
                <tr data-username="staff_nam" data-fullname="Lê Hoàng Nam" data-email="nam.lh@wms.com" data-role="EMPLOYEE" data-status="active">
                    <td class="font-mono"><strong>staff_nam</strong></td>
                    <td class="font-medium col-fullname">Lê Hoàng Nam</td>
                    <td class="col-email">nam.lh@wms.com</td>
                    <td class="col-role"><span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:600;">Nhân viên kho</span></td>
                    <td class="status-cell"><span class="status-badge status-active">Hoạt động</span></td>
                    <td style="color:#64748b;">15/02/2026</td>
                    <td class="text-right action-cell">
                        <button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                        <button class="btn-action" title="Đổi mật khẩu"><i class="fa-solid fa-key"></i></button>
                        <button class="btn-action delete" style="color:#dc2626;" title="Vô hiệu hóa tài khoản" onclick="openDeactivateModal(this)"><i class="fa-solid fa-user-slash"></i></button>
                    </td>
                </tr>
                <tr data-username="staff_tam" data-fullname="Võ Minh Tâm" data-email="tam.vm@wms.com" data-role="EMPLOYEE" data-status="inactive">
                    <td class="font-mono"><strong>staff_tam</strong></td>
                    <td class="font-medium col-fullname">Võ Minh Tâm</td>
                    <td class="col-email">tam.vm@wms.com</td>
                    <td class="col-role"><span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:600;">Nhân viên kho</span></td>
                    <td class="status-cell"><span class="status-badge status-inactive">Đã khóa</span></td>
                    <td style="color:#64748b;">20/02/2026</td>
                    <td class="text-right action-cell">
                        <button class="btn-action edit" title="Chỉnh sửa" onclick="openEditUserModal(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action" style="color:#2563eb;" title="Gán vai trò" onclick="openAssignRoleModal(this)"><i class="fa-solid fa-user-shield"></i></button>
                        <button class="btn-action" title="Mở khóa"><i class="fa-solid fa-lock-open"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG -->
    <div class="table-pagination">
        <span class="pagination-info" id="paginationInfo">Hiển thị 4 trên 4 tài khoản</span>
        <div class="pagination-buttons">
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-left"></i></button>
            <button class="btn-page active">1</button>
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>
</div>

<!-- CÁC COMPONENT MODAL ĐÃ TÁCH RIÊNG -->
<partial name="Partials/_CreateUserModal" />
<partial name="Partials/_EditUserModal" />
<partial name="Partials/_AssignRoleModal" />
<partial name="Partials/_DeactivateUserModal" />

@section Scripts {
    <script src="~/js/user-management.js" asp-append-version="true"></script>
}