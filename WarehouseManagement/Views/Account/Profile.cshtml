@{
    ViewData["Title"] = "Trang Cá Nhân & Đổi Mật Khẩu";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Hồ Sơ Cá Nhân</h1>
        <p class="page-subtitle">Quản lý thông tin tài khoản và thiết lập bảo mật mật khẩu</p>
    </div>
</div>

<div class="grid-2">
    <!-- CỘT 1: THÔNG TIN CÁ NHÂN -->
    <div class="card" id="profile-info">
        <div class="card-header">
            <h3>Thông tin tài khoản</h3>
        </div>
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px;">
                <div class="user-avatar" style="width: 64px; height: 64px; font-size: 24px; background: #0f172a; color: #ffffff;">A</div>
                <div>
                    <h2 style="font-size: 18px; font-weight: 700; color: #0f172a;">Nguyễn Văn A</h2>
                    <span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:600; margin-top: 4px;">Quản trị viên (Admin)</span>
                </div>
            </div>

            <form onsubmit="handleUpdateProfile(event)">
                <div class="form-group">
                    <label class="form-label">Tên đăng nhập</label>
                    <input type="text" class="form-input" value="admin" readonly style="background:#f1f5f9;" />
                </div>
                <div class="form-group">
                    <label class="form-label">Họ và tên</label>
                    <input type="text" class="form-input" value="Nguyễn Văn A" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Email liên hệ</label>
                    <input type="email" class="form-input" value="admin@wms.com" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Ngày kích hoạt tài khoản</label>
                    <input type="text" class="form-input" value="10/01/2026" readonly style="background:#f1f5f9;" />
                </div>
                <div style="margin-top: 20px; text-align: right;">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>

    <!-- CỘT 2: ĐỔI MẬT KHẨU -->
    <div class="card" id="change-password">
        <div class="card-header">
            <h3>Bảo mật & Đổi mật khẩu</h3>
        </div>
        <div class="card-body">
            @if (TempData["PasswordChangeSuccess"] is string successMessage)
            {
                <p role="status" style="padding: 12px; border-radius: 8px; background: #dcfce7; color: #166534;">@successMessage</p>
            }
            @if (TempData["PasswordChangeError"] is string errorMessage)
            {
                <p role="alert" style="padding: 12px; border-radius: 8px; background: #fee2e2; color: #991b1b;">@errorMessage</p>
            }
            <form asp-controller="Account" asp-action="ChangePassword" method="post" autocomplete="off" id="changePasswordForm" data-url="@Url.Action("ChangePassword", "Account")">
                <div class="form-group">
                    <label class="form-label" for="currentPassword">Mật khẩu hiện tại <span class="required">*</span></label>
                    <div class="password-field">
                        <input id="currentPassword" name="currentPassword" type="password" class="form-input" autocomplete="off" required />
                        <button type="button" class="password-toggle" data-target="currentPassword" data-label="mật khẩu hiện tại" aria-label="Hiện mật khẩu hiện tại" aria-controls="currentPassword" aria-pressed="false" title="Hiện mật khẩu hiện tại"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="newPassword">Mật khẩu mới <span class="required">*</span></label>
                    <div class="password-field">
                        <input id="newPassword" name="newPassword" type="password" class="form-input" autocomplete="new-password" required />
                        <button type="button" class="password-toggle" data-target="newPassword" data-label="mật khẩu mới" aria-label="Hiện mật khẩu mới" aria-controls="newPassword" aria-pressed="false" title="Hiện mật khẩu mới"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="confirmPassword">Xác nhận mật khẩu mới <span class="required">*</span></label>
                    <div class="password-field">
                        <input id="confirmPassword" name="confirmPassword" type="password" class="form-input" autocomplete="new-password" required />
                        <button type="button" class="password-toggle" data-target="confirmPassword" data-label="mật khẩu xác nhận" aria-label="Hiện mật khẩu xác nhận" aria-controls="confirmPassword" aria-pressed="false" title="Hiện mật khẩu xác nhận"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
                    </div>
                </div>

                <div style="margin-top: 24px; text-align: right;">
                    <button type="submit" class="btn btn-primary">Cập nhật mật khẩu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/account-profile.js" asp-append-version="true"></script>
}
