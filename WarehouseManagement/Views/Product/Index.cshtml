@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý Sản phẩm</h1>
        <p class="page-subtitle">Danh mục tất cả hàng hóa, mã SKU, giá bán và trạng thái tồn kho</p>
    </div>
    <button class="btn btn-primary" onclick="openModal('createProductModal')">
        <i class="fa-solid fa-plus"></i> Thêm sản phẩm
    </button>
</div>

<!-- THANH CÔNG CỤ TÌM KIẾM & BỘ LỌC -->
<div class="card toolbar-card">
    <div class="toolbar">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchInput" placeholder="Tìm theo mã SKU, tên sản phẩm..." onkeyup="filterProducts()" />
        </div>
        <div class="filters">
            <select id="categoryFilter" onchange="filterProducts()" class="form-select">
                <option value="">Tất cả danh mục</option>
                <option value="Đồ uống">Đồ uống</option>
                <option value="Bánh kẹo">Bánh kẹo</option>
                <option value="Gia vị">Gia vị</option>
                <option value="Đồ đóng hộp">Đồ đóng hộp</option>
            </select>
            <select id="statusFilter" onchange="filterProducts()" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="active">Đang kinh doanh</option>
                <option value="inactive">Ngừng kinh doanh</option>
            </select>
        </div>
    </div>
</div>

<!-- BẢNG DỮ LIỆU SẢN PHẨM -->
<div class="card table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>MÃ SKU</th>
                    <th>TÊN SẢN PHẨM</th>
                    <th>DANH MỤC</th>
                    <th>ĐVT</th>
                    <th>GIÁ NHẬP</th>
                    <th>GIÁ XUẤT</th>
                    <th>TỒN KHO</th>
                    <th>THEO DÕI HSD</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-right">THAO TÁC</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                <tr data-sku="SKU-COCA-330" data-category="Đồ uống" data-status="active">
                    <td class="font-mono"><strong>SKU-COCA-330</strong></td>
                    <td class="font-medium">Coca Cola Lon 330ml</td>
                    <td><span class="badge badge-gray">Đồ uống</span></td>
                    <td>Lon</td>
                    <td>8,500 ₫</td>
                    <td>10,000 ₫</td>
                    <td><span class="stock-badge in-stock">1,250</span></td>
                    <td><span class="tag-expiry yes"><i class="fa-solid fa-check-circle"></i> Có HSD</span></td>
                    <td><span class="status-badge status-active">Đang bán</span></td>
                    <td class="text-right">
                        <button class="btn-action edit" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action delete" title="Xóa"><i class="fa-solid fa-trash-can" style="color:#ef4444;"></i></button>
                    </td>
                </tr>
                <tr data-sku="SKU-MI-HAOHAO" data-category="Đồ đóng hộp" data-status="active">
                    <td class="font-mono"><strong>SKU-MI-HAOHAO</strong></td>
                    <td class="font-medium">Mì Tôm Hảo Hảo Chua Cay</td>
                    <td><span class="badge badge-gray">Đồ đóng hộp</span></td>
                    <td>Thùng</td>
                    <td>112,000 ₫</td>
                    <td>125,000 ₫</td>
                    <td><span class="stock-badge low-stock">18 (Sắp hết)</span></td>
                    <td><span class="tag-expiry yes"><i class="fa-solid fa-check-circle"></i> Có HSD</span></td>
                    <td><span class="status-badge status-active">Đang bán</span></td>
                    <td class="text-right">
                        <button class="btn-action edit" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action delete" title="Xóa"><i class="fa-solid fa-trash-can" style="color:#ef4444;"></i></button>
                    </td>
                </tr>
                <tr data-sku="SKU-BANH-CHOCO" data-category="Bánh kẹo" data-status="inactive">
                    <td class="font-mono"><strong>SKU-BANH-CHOCO</strong></td>
                    <td class="font-medium">Bánh Chocopie Hộp 12 Cái</td>
                    <td><span class="badge badge-gray">Bánh kẹo</span></td>
                    <td>Hộp</td>
                    <td>48,000 ₫</td>
                    <td>55,000 ₫</td>
                    <td><span class="stock-badge out-stock">0</span></td>
                    <td><span class="tag-expiry yes"><i class="fa-solid fa-check-circle"></i> Có HSD</span></td>
                    <td><span class="status-badge status-inactive">Ngừng bán</span></td>
                    <td class="text-right">
                        <button class="btn-action edit" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action delete" title="Xóa"><i class="fa-solid fa-trash-can" style="color:#ef4444;"></i></button>
                    </td>
                </tr>
                <tr data-sku="SKU-NUOCMAM-CHINSU" data-category="Gia vị" data-status="active">
                    <td class="font-mono"><strong>SKU-NUOCMAM-CHINSU</strong></td>
                    <td class="font-medium">Nước Mắm Nam Ngư 500ml</td>
                    <td><span class="badge badge-gray">Gia vị</span></td>
                    <td>Chai</td>
                    <td>32,000 ₫</td>
                    <td>38,000 ₫</td>
                    <td><span class="stock-badge in-stock">340</span></td>
                    <td><span class="tag-expiry no"><i class="fa-solid fa-circle-xmark"></i> Không</span></td>
                    <td><span class="status-badge status-active">Đang bán</span></td>
                    <td class="text-right">
                        <button class="btn-action edit" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="btn-action delete" title="Xóa"><i class="fa-solid fa-trash-can" style="color:#ef4444;"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG -->
    <div class="table-pagination">
        <span class="pagination-info">Hiển thị 4 trên 4 sản phẩm</span>
        <div class="pagination-buttons">
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-left"></i></button>
            <button class="btn-page active">1</button>
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>
</div>

<!-- MODAL THÊM / SỬA SẢN PHẨM -->
<div id="createProductModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <h3><i class="fa-solid fa-box-open" style="margin-right:8px;"></i> Thêm sản phẩm mới</h3>
            <button class="modal-close" onclick="closeModal('createProductModal')">&times;</button>
        </div>
        <form id="productForm" onsubmit="handleSaveProduct(event)">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Mã SKU <span class="required">*</span></label>
                        <input type="text" class="form-input" placeholder="VD: SKU-SP-001" required />
                    </div>
                    <div class="form-group flex-2">
                        <label class="form-label">Tên sản phẩm <span class="required">*</span></label>
                        <input type="text" class="form-input" placeholder="Nhập tên sản phẩm..." required />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Nhóm hàng / Danh mục</label>
                        <select class="form-select">
                            <option>Đồ uống</option>
                            <option>Bánh kẹo</option>
                            <option>Gia vị</option>
                            <option>Đồ đóng hộp</option>
                        </select>
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Đơn vị tính</label>
                        <select class="form-select">
                            <option>Lon</option>
                            <option>Chai</option>
                            <option>Thùng</option>
                            <option>Hộp</option>
                            <option>Kg</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Giá nhập (VNĐ)</label>
                        <input type="number" class="form-input" placeholder="0" min="0" />
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Giá bán (VNĐ)</label>
                        <input type="number" class="form-input" placeholder="0" min="0" />
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Tồn kho tối thiểu</label>
                        <input type="number" class="form-input" placeholder="10" min="0" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="hasExpiryCheckbox" checked />
                        <span>Sản phẩm này cần theo dõi Hạn sử dụng (HSD) khi nhập/xuất kho</span>
                    </label>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('createProductModal')">Hủy</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Lưu sản phẩm</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openModal(modalId) { document.getElementById(modalId).classList.add('show'); }
    function closeModal(modalId) { document.getElementById(modalId).classList.remove('show'); }

    function filterProducts() {
        const searchText = document.getElementById('searchInput').value.toLowerCase();
        const category = document.getElementById('categoryFilter').value;
        const status = document.getElementById('statusFilter').value;
        const rows = document.querySelectorAll('#productTableBody tr');

        rows.forEach(row => {
            const sku = row.getAttribute('data-sku').toLowerCase();
            const text = row.innerText.toLowerCase();
            const rowCat = row.getAttribute('data-category');
            const rowStatus = row.getAttribute('data-status');

            const matchSearch = text.includes(searchText) || sku.includes(searchText);
            const matchCategory = !category || rowCat === category;
            const matchStatus = !status || rowStatus === status;

            row.style.display = (matchSearch && matchCategory && matchStatus) ? '' : 'none';
        });
    }

    function handleSaveProduct(e) {
        e.preventDefault();
        alert('Đã lưu thông tin sản phẩm thành công!');
        closeModal('createProductModal');
    }
</script>
}
