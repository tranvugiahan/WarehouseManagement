                    <th>TỒN ĐẦU KỲ</th>
                    <th>NHẬP TRONG KỲ</th>
                    <th>XUẤT TRONG KỲ</th>
                    <th>XUẤT HỦY</th>
                    <th>TỒN CUỐI KỲ</th>
                    <th>THÀNH TIỀN TỒN</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="font-mono"><strong>SKU-COCA-330</strong></td>
                    <td class="font-medium">Coca Cola Lon 330ml</td>
                    <td>Lon</td>
                    <td>474</td>
                    <td class="diff-positive">+2,000</td>
                    <td class="diff-negative">-1,200</td>
                    <td class="diff-negative">-24</td>
                    <td><strong style="color:#0f172a;">1,250</strong></td>
                    <td>10,625,000 ₫</td>
                </tr>
                <tr>
                    <td class="font-mono"><strong>SKU-MI-HAOHAO</strong></td>
                    <td class="font-medium">Mì Tôm Hảo Hảo Chua Cay</td>
                    <td>Thùng</td>
                    <td>98</td>
                    <td class="diff-positive">0</td>
                    <td class="diff-negative">-80</td>
                    <td class="diff-zero">0</td>
                    <td><strong style="color:#0f172a;">18</strong></td>
                    <td>2,016,000 ₫</td>
                </tr>
                <tr>
                    <td class="font-mono"><strong>SKU-BANH-CHOCO</strong></td>
                    <td class="font-medium">Bánh Chocopie 12 Cái</td>
                    <td>Hộp</td>
                    <td>306</td>
                    <td class="diff-positive">0</td>
                    <td class="diff-negative">-300</td>
                    <td class="diff-negative">-6</td>
                    <td><strong style="color:#dc2626;">0</strong></td>
                    <td>0 ₫</td>
                </tr>
                <tr>
                    <td class="font-mono"><strong>SKU-NUOCMAM-CHINSU</strong></td>
                    <td class="font-medium">Nước Mắm Nam Ngư 500ml</td>
                    <td>Chai</td>
                    <td>390</td>
                    <td class="diff-positive">0</td>
                    <td class="diff-negative">-50</td>
                    <td class="diff-zero">0</td>
                    <td><strong style="color:#0f172a;">340</strong></td>
                    <td>10,880,000 ₫</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG -->
    <div class="table-pagination">
        <span class="pagination-info">Hiển thị báo cáo 4 sản phẩm phát sinh giao dịch</span>
        <div class="pagination-buttons">
            <button class="btn-page active">1</button>
        </div>
    </div>
</div>
