@{
    ViewData["Title"] = "Phiếu Xuất Giao Hàng";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Phiếu Xuất Giao Hàng</h1>
        <p class="page-subtitle">Xuất kho phân phối hàng hóa đến các chi nhánh, đại lý hoặc điểm giao nhận</p>
    </div>
    <button class="btn btn-primary" onclick="openModal('createExportModal')">
        <i class="fa-solid fa-plus"></i> Tạo phiếu xuất kho
    </button>
</div>

<!-- THANH TÌM KIẾM & BỘ LỌC -->
<div class="card toolbar-card">
    <div class="toolbar">
        <div class="search-box">
            <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="searchExportInput" placeholder="Tìm theo mã PX, điểm đến, người nhận..." onkeyup="filterExports()" />
        </div>
        <div class="filters">
            <select id="exportStatusFilter" onchange="filterExports()" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="pending">Chờ xuất kho</option>
                <option value="completed">Đã xuất kho</option>
                <option value="cancelled">Đã hủy</option>
            </select>
        </div>
    </div>
</div>

<!-- BẢNG DỮ LIỆU PHIẾU XUẤT -->
<div class="card table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>MÃ PHIẾU</th>
                    <th>NƠI ĐẾN (ĐIỂM GIAO)</th>
                    <th>NGÀY XUẤT</th>
                    <th>NGƯỜI LẬP</th>
                    <th>TỔNG SỐ LƯỢNG</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-right">THAO TÁC</th>
                </tr>
            </thead>
            <tbody id="exportTableBody">
                <tr data-status="pending">
                    <td class="font-mono"><strong>PX-2026-015</strong></td>
                    <td class="font-medium">Đại lý Miền Đông - Thủ Đức</td>
                    <td style="color:#64748b;">13/10/2026</td>
                    <td>Lê Hoàng Nam</td>
                    <td><strong>350 Lon / Thùng</strong></td>
                    <td><span class="status-badge status-pending">Chờ xuất kho</span></td>
                    <td class="text-right">
                        <button class="btn-action" title="Xác nhận xuất kho" onclick="alert('Đã trừ tồn kho và hoàn tất xuất hàng!')"><i class="fa-solid fa-check" style="color:#16a34a;"></i></button>
                        <button class="btn-action" title="Xem chi tiết"><i class="fa-solid fa-eye"></i></button>
                        <button class="btn-action delete" title="Hủy"><i class="fa-solid fa-trash-can" style="color:#ef4444;"></i></button>
                    </td>
                </tr>
                <tr data-status="completed">
                    <td class="font-mono"><strong>PX-2026-014</strong></td>
                    <td class="font-medium">Chi nhánh Cửa hàng Quận 1</td>
                    <td style="color:#64748b;">11/10/2026</td>
                    <td>Nguyễn Văn A</td>
                    <td><strong>800 Thùng</strong></td>
                    <td><span class="status-badge status-completed">Đã xuất kho</span></td>
                    <td class="text-right">
                        <button class="btn-action" title="Xem chi tiết"><i class="fa-solid fa-eye"></i></button>
                        <button class="btn-action" title="In phiếu giao"><i class="fa-solid fa-print"></i></button>
                    </td>
                </tr>
                <tr data-status="completed">
                    <td class="font-mono"><strong>PX-2026-013</strong></td>
                    <td class="font-medium">Kho trung chuyển Bình Dương</td>
                    <td style="color:#64748b;">08/10/2026</td>
                    <td>Trần Thị B</td>
                    <td><strong>1,200 Lon</strong></td>
                    <td><span class="status-badge status-completed">Đã xuất kho</span></td>
                    <td class="text-right">
                        <button class="btn-action" title="Xem chi tiết"><i class="fa-solid fa-eye"></i></button>
                        <button class="btn-action" title="In phiếu giao"><i class="fa-solid fa-print"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG -->
    <div class="table-pagination">
        <span class="pagination-info">Hiển thị 3 trên 3 phiếu xuất</span>
        <div class="pagination-buttons">
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-left"></i></button>
            <button class="btn-page active">1</button>
            <button class="btn-page" disabled><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>
</div>

<!-- MODAL TẠO PHIẾU XUẤT -->
<div id="createExportModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 700px;">
        <div class="modal-header">
            <h3>Lập phiếu xuất giao hàng mới</h3>
            <button class="modal-close" onclick="closeModal('createExportModal')">&times;</button>
        </div>
        <form onsubmit="handleSaveExport(event)">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Mã phiếu xuất</label>
                        <input type="text" class="form-input" value="PX-2026-016" readonly style="background:#f1f5f9;" />
                    </div>
                    <div class="form-group flex-2">
                        <label class="form-label">Nơi nhận / Điểm giao hàng <span class="required">*</span></label>
                        <input type="text" class="form-input" placeholder="Tên chi nhánh, đại lý, địa chỉ nhận..." required />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group flex-2">
                        <label class="form-label">Sản phẩm xuất kho</label>
                        <select class="form-select">
                            <option>Coca Cola Lon 330ml (Tồn: 1,250)</option>
                            <option>Mì Hảo Hảo Chua Cay (Tồn: 18)</option>
                            <option>Nước Mắm Nam Ngư 500ml (Tồn: 340)</option>
                        </select>
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Số lượng xuất <span class="required">*</span></label>
                        <input type="number" class="form-input" placeholder="0" min="1" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Ghi chú vận chuyển</label>
                    <input type="text" class="form-input" placeholder="Biển số xe, người vận chuyển..." />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('createExportModal')">Hủy</button>
                <button type="submit" class="btn btn-primary">Xác nhận tạo phiếu</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openModal(id) { document.getElementById(id).classList.add('show'); }
    function closeModal(id) { document.getElementById(id).classList.remove('show'); }

    function filterExports() {
        const keyword = document.getElementById('searchExportInput').value.toLowerCase();
        const status = document.getElementById('exportStatusFilter').value;
        const rows = document.querySelectorAll('#exportTableBody tr');

        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const rowStatus = row.getAttribute('data-status');

            const matchText = text.includes(keyword);
            const matchStatus = !status || rowStatus === status;

            row.style.display = (matchText && matchStatus) ? '' : 'none';
        });
    }

    function handleSaveExport(e) {
        e.preventDefault();
        alert('Đã tạo phiếu xuất kho thành công!');
        closeModal('createExportModal');
    }
</script>
}
